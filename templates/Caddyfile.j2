## {{ ansible_managed }}

{% macro render_geoblock(config) -%}
    geoblock {
{% for option in ['db_path', 'allow_countries', 'allow_continents', 'allow_subdivisions', 'allow_cities', 'allow_asn', 'allow_asn_org', 'deny_countries', 'deny_continents', 'deny_subdivisions', 'deny_cities', 'deny_asn', 'deny_asn_org', 'allow_ip_ranges', 'deny_ip_ranges', 'blocked_status', 'blocked_message'] %}
{% if config[option] is defined %}
{% if option == 'db_path' and config[option] is not string %}
{% for value in config[option] %}        {{ option }} {{ value }}
{% endfor %}
{% elif config[option] is string %}        {{ option }} {{ config[option] }}
{% else %}
    {{ option }} {{ config[option] | join(' ') }}
{% endif %}
{% endif %}
{% endfor %}
    }
{%- endmacro %}

{
    log {
        output file /var/log/caddy/caddy.log {
            mode 0644
            roll_size 1mb
            roll_keep 3
        }
        format json
    }
}

{% if caddy_tls_providers is defined %}
{% for item in caddy_tls_providers %}

({{ item.provider }}) {
    tls {
        {{ item.challenge_type }} {{ item.provider }} {{ item.provider_api_token }}
{% if item.resolver is defined %}
        resolvers {{ item.resolver_ip }}
{% endif %}
    }
}
{% endfor %}
{% endif %}

{% if caddy_endpoints is defined %}
{% for endpoint in caddy_endpoints %}

# {{ endpoint.friendly_name }}
{% if endpoint.fqdn.startswith("*") %}
{{ endpoint.fqdn }} {
    import {{ endpoint.tls_provider }}
{% if caddy_geoblock is defined %}
{{ render_geoblock(caddy_geoblock) }}
{% endif %}

{% if endpoint.wildcard_endpoints is defined %}
{% for wildcard_endpoint in endpoint.wildcard_endpoints %}
    @{{ ( wildcard_endpoint.fqdn | split(".") )[0] }} host {{ wildcard_endpoint.fqdn }}
    handle @{{ ( wildcard_endpoint.fqdn | split(".") )[0] }} {
    log {
        format transform "{common_log}"
        output file /var/log/caddy/{{ wildcard_endpoint.fqdn }}/access.log {
            mode 0644
            roll_size 1mb
            roll_keep 3
        }
    }
{% if wildcard_endpoint.tls_insecure | default(false) %}
        reverse_proxy {{ wildcard_endpoint.upstream }} {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
{% else %}
        reverse_proxy {{ wildcard_endpoint.upstream }}
    }
{% endif %}
{% endfor %}
{% endif %}
    # Fallback for otherwise unhandled domains
    handle {
        abort
    }
}
{% else %}
{% if endpoint.tls_insecure | default(false) %}
{{ endpoint.fqdn }} {
{% if caddy_geoblock is defined %}
{{ render_geoblock(caddy_geoblock) }}
{% endif %}
    reverse_proxy {{ endpoint.upstream }} {
        transport http {
            tls_insecure_skip_verify
        }
    }
    log {
        format transform "{common_log}"
        output file /var/log/caddy/{{ endpoint.fqdn }}/access.log {
            mode 0644
            roll_size 1mb
            roll_keep 3
        }
    }
    import {{ endpoint.tls_provider }}
}
{% else %}
{{ endpoint.fqdn }} {
{% if caddy_geoblock is defined %}
{{ render_geoblock(caddy_geoblock) }}
{% endif %}
    reverse_proxy {{ endpoint.upstream }}
    log {
        format transform "{common_log}"
        output file /var/log/caddy/{{ endpoint.fqdn }}/access.log {
            mode 0644
            roll_size 1mb
            roll_keep 3
        }
    }
    import {{ endpoint.tls_provider }}
}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
